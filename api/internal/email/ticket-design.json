{
  "version": 1,
  "colors": {
    "background": "#0a0a0a",
    "foreground": "#ffffff",
    "accent": "#ff0044",
    "muted": "#999999",
    "border": "#343434"
  },
  "template": "<table data-ticket-pass=\"true\" role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" bgcolor=\"#0a0a0a\" style=\"width:100%;max-width:440px;margin:0 auto;border:1px solid #343434;border-radius:24px;background:#0a0a0a;color:#ffffff;font-family:Arial,Helvetica,sans-serif;table-layout:fixed;border-collapse:separate;border-spacing:0;box-sizing:border-box;line-height:normal;letter-spacing:normal;text-align:left;overflow:hidden\">\n<tr><td style=\"padding:20px 20px 16px;border-bottom:1px dashed #343434\">\n<div style=\"font-size:16px;font-weight:900;letter-spacing:3px;color:#ffffff\">SPOTTR<span style=\"color:#ff0044\">.</span></div>\n<div style=\"margin-top:12px;color:#ff0044;font-size:11px;font-weight:700;letter-spacing:1px;text-transform:uppercase;overflow-wrap:anywhere\">{{type}}</div>\n<div style=\"margin-top:8px;font-size:24px;line-height:1.2;font-weight:800;color:#ffffff;overflow-wrap:anywhere\">{{title}}</div>\n<div style=\"margin-top:12px;color:#999999;font-size:10px;text-transform:uppercase;letter-spacing:1px\">{{dateLabel}}</div>\n<div style=\"margin-top:5px;color:#ffffff;font-size:13px;line-height:1.5\">{{date}}</div>\n<div style=\"margin-top:8px;color:#999999;font-size:10px;text-transform:uppercase;letter-spacing:1px\">{{locationLabel}}</div>\n<div style=\"margin-top:5px;color:#ffffff;font-size:13px;line-height:1.5;overflow-wrap:anywhere\">{{location}}</div>\n</td></tr>\n<tr><td align=\"center\" style=\"padding:18px 20px\">\n<table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" bgcolor=\"#ffffff\" style=\"margin:0 auto;background:#ffffff;border-radius:16px\"><tr><td style=\"padding:14px\"><img src=\"{{qr}}\" width=\"220\" height=\"220\" alt=\"{{qrLabel}}\" style=\"display:block;width:220px;max-width:100%;height:auto;border:0;background:#ffffff\" /></td></tr></table>\n<div style=\"margin-top:18px;color:#999999;font-size:10px;text-transform:uppercase;letter-spacing:1px\">{{codeLabel}}</div>\n<div style=\"margin-top:6px;color:#cccccc;font-family:monospace;font-size:10px;line-height:1.5;overflow-wrap:anywhere;word-break:break-all\">{{id}}</div>\n</td></tr>\n<tr><td style=\"padding:16px 22px;border-top:1px dashed #343434;color:#999999;font-size:11px;line-height:1.6;text-align:center\">{{hint}}</td></tr>\n</table>"
}
