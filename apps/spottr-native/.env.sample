EXPO_PUBLIC_API_URL=https://api-staging.spottr.ro/api/v1
EXPO_PUBLIC_WEB_URL=https://dev.spottr.ro
# Copy this file to .env.local, then restart Expo after changing the API URL.
# Diagnostics are enabled in release builds and disabled in development by default.
# To test reporting in Metro/Xcode Debug, set this to true in .env.local and restart/rebuild.
# EXPO_PUBLIC_DIAGNOSTICS_ENABLED=true
# Web development uses the Metro proxy. iOS/Android connect directly to this URL.
# Static web deployments must allow their origin in the API's CORS configuration.
# For a physical device, use your computer's LAN IP, never localhost.
# Android emulator reaches your computer through http://10.0.2.2:8080/api/v1.

# Discovery maps use OpenFreeMap/MapLibre; no map API key is required.

# Public signing identifiers used by pnpm configure:links. No private keys.
# Team ID: Xcode > Signing & Capabilities. Android: signing certificate SHA-256.
SPOTTR_NATIVE_APPLE_TEAM_ID=
SPOTTR_NATIVE_ANDROID_SHA256=
EXPO_PUBLIC_LINK_HOSTS=spottr.ro,www.spottr.ro,dev.spottr.ro

# Optional wallets for the native Stripe PaymentSheet. Cards do not require these.
# Apple Pay: a real Merchant ID + payment processing certificate configured for Stripe.
SPOTTR_NATIVE_APPLE_MERCHANT_ID=
# Enable only after Google Pay setup; test mode follows the server Stripe public key.
SPOTTR_NATIVE_GOOGLE_PAY_ENABLED=false
# Stripe publishable key is returned by our API from server STRIPE_PUBLISHABLE_KEY.
# Never put a Stripe secret key in the mobile app. Rebuild after changing wallet settings.

# Remote push: public EAS project UUID, also configured in the API.
# Requires APNs/FCM credentials uploaded to this Expo project and a new native build.
EXPO_PUBLIC_EAS_PROJECT_ID=
# Android client config downloaded from the matching Firebase project (not a service account key).
SPOTTR_NATIVE_GOOGLE_SERVICES_FILE=
