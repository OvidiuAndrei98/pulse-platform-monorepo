{
  "name": "@apps/spottr-native",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "web": "expo start --web --port 8081",
    "android": "expo run:android",
    "ios": "node scripts/verify-ios-native-sources.cjs && expo run:ios --device",
    "ios:release": "node scripts/verify-ios-native-sources.cjs && expo run:ios --device --configuration Release",
    "ios:ipa": "node scripts/verify-ios-native-sources.cjs && node scripts/build-ios-ipa.cjs",
    "prebuild:ios": "node scripts/verify-ios-native-sources.cjs && expo prebuild --platform ios --no-clean",
    "verify:ios-native": "node scripts/verify-ios-native-sources.cjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:web": "node tests/browser.cjs",
    "test:sheets": "node tests/browser-sheet.cjs",
    "test:sheet-dismiss": "node tests/browser-sheet.cjs --dismiss-timing-only",
    "test:checkout": "node tests/browser-checkout.cjs",
    "test:confirmation": "node tests/browser-confirmation.cjs",
    "test:notifications": "node tests/browser-notifications.cjs",
    "test:interactions": "node tests/browser-interactions.cjs",
    "test:navbar": "node tests/browser-navbar.cjs",
    "test:profiles": "node tests/browser-profiles.cjs",
    "test:profile-tickets": "node tests/browser-profile-tickets.cjs",
    "test:promotion-hero": "node tests/browser-promotion-hero.cjs",
    "test:operations": "node tests/browser-operations.cjs",
    "test:scanner": "node tests/browser-scanner.cjs",
    "test:diagnostics": "node tests/browser-diagnostics.cjs",
    "test:map": "node tests/browser-map.cjs",
    "test:organizer": "node tests/browser-organizer.cjs",
    "test:places": "node tests/browser-places.cjs",
    "test:api-preview": "node tests/browser-api.cjs",
    "export": "expo export --platform all",
    "export:web": "expo export --platform web",
    "doctor": "expo-doctor",
    "configure:links": "node scripts/configure-links.cjs",
    "test:dashboard": "node tests/browser-dashboard-parity.cjs",
    "test:dashboard-account": "node tests/browser-dashboard-account.cjs",
    "test:account-navigation": "node tests/browser-account-navigation.cjs",
    "test:company": "node tests/browser-company.cjs",
    "test:organizer-navbar": "node tests/browser-organizer-navbar.cjs",
    "test:navbar-sheets": "node tests/browser-navbar-sheets.cjs",
    "test:refresh": "node tests/browser.cjs --refresh-only"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "0.4.2",
    "@gorhom/bottom-sheet": "5.2.14",
    "@packages/api-client": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "7.20.0",
    "@react-navigation/native": "7.5.0",
    "@react-navigation/native-stack": "7.20.0",
    "@stripe/stripe-react-native": "0.64.0",
    "@tanstack/react-query": "5.104.1",
    "expo": "~57.0.27",
    "expo-asset": "~57.0.19",
    "expo-audio": "~57.0.5",
    "expo-blur": "~57.0.3",
    "expo-brightness": "~57.0.2",
    "expo-build-properties": "~57.0.22",
    "expo-camera": "~57.0.6",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.21",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-keep-awake": "~57.0.2",
    "expo-linear-gradient": "~57.0.2",
    "expo-localization": "~57.0.2",
    "expo-location": "~57.0.20",
    "expo-network": "~57.0.2",
    "expo-notifications": "~57.0.22",
    "expo-print": "~57.0.2",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.22",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-web-browser": "~57.0.3",
    "leaflet": "1.9.4",
    "lucide-react-native": "1.52.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-maps": "1.27.2",
    "react-native-qrcode-svg": "6.3.26",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/leaflet": "1.9.21",
    "@types/node": "20.19.43",
    "@types/react": "~19.2.2",
    "expo-doctor": "latest",
    "tsx": "^4.20.0",
    "typescript": "~6.0.3",
    "yoga-layout": "3.2.1"
  }
}
