# PostgreSQL
DB_HOST=hostname
DB_PORT=dbport
DB_USER=dbuser
DB_PASSWORD=dbpassword
DB_NAME=dbname
DB_SSLMODE=disable

# Go API Port
PORT=8080

# Public application URLs
PUBLIC_APP_URL=https://spottr.ro
PUBLIC_API_URL=https://api.spottr.ro
CORS_ALLOWED_ORIGINS=https://spottr.ro,https://www.spottr.ro

# Next.js / Capacitor
NEXT_PUBLIC_API_URL=https://api.spottr.ro/api/v1
CAPACITOR_SERVER_URL=https://spottr.ro

# Stripe promotion plans (RON, one-time payment)
PROMOTION_ONE_DAY_PRICE_RON=50
PROMOTION_THU_SAT_PRICE_RON=120
PROMOTION_FULL_WEEK_PRICE_RON=200
PROMOTION_FEED_ONE_DAY_PRICE_RON=10
PROMOTION_FEED_THU_SAT_PRICE_RON=25
PROMOTION_FEED_FULL_WEEK_PRICE_RON=50
