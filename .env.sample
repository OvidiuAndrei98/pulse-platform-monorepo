# PostgreSQL
DB_HOST=hostname
DB_PORT=dbport
DB_USER=dbuser
DB_PASSWORD=
DB_NAME=dbname
# Remote databases require verify-full. Use disable only for localhost/loopback.
DB_SSLMODE=verify-full
DB_SSLROOTCERT=/etc/ssl/certs/aws-rds-global-bundle.pem

# Go API Port
PORT=8080

# Public application URLs
PUBLIC_APP_URL=https://spottr.ro
PUBLIC_API_URL=https://api.spottr.ro
CORS_ALLOWED_ORIGINS=https://spottr.ro,https://www.spottr.ro
# Comma-separated CIDRs of the ALB subnets. Forwarded IP headers are ignored
# unless the immediate socket peer belongs to one of these trusted networks.
TRUSTED_PROXY_CIDRS=

# Storage. Use a dedicated bucket for each environment so staging cleanup can
# never remove production media.
S3_BUCKET=
EVENT_BANNER_GC_ENABLED=false

# Stripe. Live and test credentials must never share the same database because
# organizer Stripe account IDs belong to the mode in which they were created.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
STRIPE_CONNECT_COUNTRY=RO

# Transactional email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_FROM=hello@spottr.ro
SMTP_USERNAME=smtp-user
SMTP_PASSWORD=
SMTP_RECIPIENT_OVERRIDE=

# Next.js / Capacitor
NEXT_PUBLIC_API_URL=https://api.spottr.ro/api/v1
CAPACITOR_SERVER_URL=https://spottr.ro

# Stripe promotion plans (RON, one-time payment)
PROMOTION_ONE_DAY_PRICE_RON=50
PROMOTION_THU_SAT_PRICE_RON=120
PROMOTION_FULL_WEEK_PRICE_RON=200
PROMOTION_FEED_ONE_DAY_PRICE_RON=10
PROMOTION_FEED_THU_SAT_PRICE_RON=25
PROMOTION_FEED_FULL_WEEK_PRICE_RON=50

# Base64-encoded 32-byte AES key used only for Oblio/SmartBill API credentials.
# Generate once and keep the same value in AWS Secrets Manager.
INVOICING_ENCRYPTION_KEY=

# Monthly SPOTTR commission invoices. VAT name and percentage must match the
# selected provider's nomenclature exactly. For a non-VAT payer use 0 and leave
# SPOTTR_INVOICING_VAT_NAME empty.
SPOTTR_INVOICING_PROVIDER=
SPOTTR_INVOICING_ACCOUNT_EMAIL=
SPOTTR_INVOICING_API_TOKEN=
SPOTTR_INVOICING_COMPANY_VAT_CODE=
SPOTTR_INVOICING_SERIES_NAME=
SPOTTR_INVOICING_VAT_NAME=
SPOTTR_INVOICING_VAT_PERCENTAGE=0
SPOTTR_INVOICING_SEND_EMAIL=true
SPOTTR_INVOICING_SEND_TO_SPV=true
SPOTTR_INVOICING_PAYMENT_TYPE=
