// Logical current schema for Glow. See Goose migrations for physical details.

Table users {
  id uuid [pk]
  username varchar(50) [not null, unique]
  email varchar(100) [not null, unique]
  password_hash varchar(255)
  avatar_url text
  role varchar(20)
  bio text
  is_active boolean
  google_id varchar(255) [unique]
  preferred_language text
  show_attendance_publicly boolean
  created_at timestamptz
}

Table organizer_profiles {
  id uuid [pk]
  user_id uuid [not null, unique]
  cui varchar(20) [not null, unique]
  company_name varchar(255) [not null]
  fiscal_address text [not null]
  is_verified boolean
  verified_at timestamptz
  verification_status verification_status_type
  stripe_account_id varchar(255) [unique]
  stripe_charges_enabled boolean
  stripe_payouts_enabled boolean
  stripe_details_submitted boolean
  organizer_agreement_version varchar(64)
  organizer_agreement_accepted_at timestamptz
  organizer_agreement_accepted_ip inet
  created_at timestamptz
  updated_at timestamptz
}

Table events {
  id uuid [pk]
  organizer_id uuid
  title varchar(100) [not null]
  description text
  category varchar(50) [not null]
  status varchar(255)
  banner_url text
  google_place_id varchar(255)
  location_address text
  location_name varchar(255) [not null]
  city varchar(100) [not null]
  vibe varchar(50) [not null]
  latitude double
  longitude double
  start_time timestamptz [not null]
  end_time timestamptz [not null]
  is_live boolean
  organizer_absorbs_service_fee boolean
  created_at timestamptz
}

Table ticket_types {
  id uuid [pk]
  event_id uuid [not null]
  name varchar(255) [not null]
  price_ron int [not null]
  capacity int [not null]
  tickets_sold int [not null]
  start_sales timestamptz [not null]
  end_sales timestamptz [not null]
  description text
  created_at timestamptz
  updated_at timestamptz
}

Table orders {
  id uuid [pk]
  user_id uuid
  event_id uuid [not null]
  email varchar(255) [not null]
  stripe_payment_intent_id varchar(255) [unique]
  stripe_checkout_session_id varchar(255) [unique]
  status order_status [not null]
  total_amount int [not null, note: 'RON amount tracked by current backend']
  platform_fee_bani int [not null]
  ticket_email_sent_at timestamptz
  created_at timestamptz
}

Table order_items {
  id uuid [pk]
  order_id uuid [not null]
  ticket_type_id uuid [not null]
  quantity int [not null]
  unit_price_ron int [not null]
  created_at timestamptz

  Indexes {
    (order_id, ticket_type_id) [unique]
  }
}

Table tickets {
  id uuid [pk]
  order_id uuid [not null]
  ticket_type_id uuid [not null]
  user_id uuid
  validation_hash varchar(64) [not null, unique]
  is_validated boolean [not null]
  validated_at timestamptz
  validated_by_user_id uuid
  validated_by_scanner_access_id uuid
  created_at timestamptz
}

Table event_rsvps {
  user_id uuid [not null]
  event_id uuid [not null]
  status varchar(16) [not null]
  created_at timestamptz
  updated_at timestamptz

  Indexes {
    (user_id, event_id) [pk]
  }
}

Table saved_events {
  user_id uuid [not null]
  event_id uuid [not null]
  created_at timestamptz

  Indexes {
    (user_id, event_id) [pk]
  }
}

Table friendships {
  user_id uuid [not null]
  friend_id uuid [not null]
  status varchar(20)

  Indexes {
    (user_id, friend_id) [pk]
  }
}

Table organizer_follows {
  follower_id uuid [not null]
  organizer_id uuid [not null]
  created_at timestamptz

  Indexes {
    (follower_id, organizer_id) [pk]
  }
}

Table event_updates {
  id uuid [pk]
  event_id uuid [not null]
  organizer_id uuid [not null]
  image_url text [not null]
  caption varchar(160)
  created_at timestamptz
  expires_at timestamptz [not null]
}

Table event_artists {
  id uuid [pk]
  event_id uuid [not null]
  name varchar(120) [not null]
  image_url text
  stage varchar(120)
  performance_time varchar(40)
  spotify_url text
  source varchar(16) [not null]
  is_headliner boolean [not null]
  sort_order int [not null]
  created_at timestamptz
}

Table check_ins {
  id uuid [pk]
  user_id uuid
  event_id uuid
  created_at timestamptz
}

Table comments {
  id uuid [pk]
  event_id uuid
  user_id uuid
  content text [not null]
  created_at timestamptz
}

Table event_joins {
  id uuid [pk]
  event_id uuid
  user_id uuid
  status varchar(20)
  created_at timestamptz
}

Table notifications {
  id uuid [pk]
  user_id uuid [not null]
  type varchar(64) [not null]
  title varchar(255) [not null]
  body text [not null]
  event_id uuid
  actor_id uuid
  read_at timestamptz
  created_at timestamptz
}

Table user_tokens {
  id uuid [pk]
  user_id uuid [not null]
  token_hash varchar(64) [not null, unique]
  type varchar(20) [not null]
  expires_at timestamptz [not null]
  created_at timestamptz
}

Table event_validation_staff {
  event_id uuid [not null]
  user_id uuid [not null]
  added_by uuid [not null]
  created_at timestamptz

  Indexes {
    (event_id, user_id) [pk]
  }
}

Table event_scanner_access {
  id uuid [pk]
  event_id uuid [not null]
  created_by uuid [not null]
  label varchar(80) [not null]
  token_hash varchar(64) [not null, unique]
  starts_at timestamptz [not null]
  ends_at timestamptz [not null]
  revoked_at timestamptz
  created_at timestamptz
}

Table offline_validation_snapshots {
  id uuid [pk]
  event_id uuid [not null]
  created_by_user_id uuid [not null]
  ticket_count int [not null]
  expires_at timestamptz [not null]
  created_at timestamptz
}

Table offline_ticket_validations {
  id uuid [pk]
  client_scan_id uuid [not null, unique]
  snapshot_id uuid [not null]
  event_id uuid [not null]
  ticket_id uuid
  validated_by_user_id uuid [not null]
  device_id varchar(128) [not null]
  validation_hash text [not null]
  scanned_at timestamptz [not null]
  synced_at timestamptz
  server_validated_at timestamptz
  result varchar(32) [not null]
  created_at timestamptz
}

Ref: organizer_profiles.user_id - users.id
Ref: events.organizer_id > users.id
Ref: ticket_types.event_id > events.id
Ref: orders.user_id > users.id
Ref: orders.event_id > events.id
Ref: order_items.order_id > orders.id
Ref: order_items.ticket_type_id > ticket_types.id
Ref: tickets.order_id > orders.id
Ref: tickets.ticket_type_id > ticket_types.id
Ref: tickets.user_id > users.id
Ref: tickets.validated_by_user_id > users.id
Ref: tickets.validated_by_scanner_access_id > event_scanner_access.id
Ref: event_rsvps.user_id > users.id
Ref: event_rsvps.event_id > events.id
Ref: saved_events.user_id > users.id
Ref: saved_events.event_id > events.id
Ref: friendships.user_id > users.id
Ref: friendships.friend_id > users.id
Ref: organizer_follows.follower_id > users.id
Ref: organizer_follows.organizer_id > users.id
Ref: event_updates.event_id > events.id
Ref: event_updates.organizer_id > users.id
Ref: event_artists.event_id > events.id
Ref: check_ins.user_id > users.id
Ref: check_ins.event_id > events.id
Ref: comments.user_id > users.id
Ref: comments.event_id > events.id
Ref: event_joins.user_id > users.id
Ref: event_joins.event_id > events.id
Ref: notifications.user_id > users.id
Ref: notifications.event_id > events.id
Ref: notifications.actor_id > users.id
Ref: user_tokens.user_id > users.id
Ref: event_validation_staff.event_id > events.id
Ref: event_validation_staff.user_id > users.id
Ref: event_validation_staff.added_by > users.id
Ref: event_scanner_access.event_id > events.id
Ref: event_scanner_access.created_by > users.id
Ref: offline_validation_snapshots.event_id > events.id
Ref: offline_validation_snapshots.created_by_user_id > users.id
Ref: offline_ticket_validations.snapshot_id > offline_validation_snapshots.id
Ref: offline_ticket_validations.event_id > events.id
Ref: offline_ticket_validations.ticket_id > tickets.id
Ref: offline_ticket_validations.validated_by_user_id > users.id
